DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/your_db
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# Authentication & JWT Secrets
ACCESS_TOKEN_SECRET=supersecret_access_token_key_change_in_production
REFRESH_TOKEN_SECRET=supersecret_refresh_token_key_change_in_production
PASSWORD_RESET_SECRET=supersecret_password_reset_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY=test-api-key

# Email Configuration (Google SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_USE_TLS=true
EMAIL_FROM="AI Document Intelligence <your_email@gmail.com>"