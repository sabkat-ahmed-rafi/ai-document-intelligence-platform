{
  "info": {
    "name": "AI Document Intelligence Platform API",
    "description": "Complete Postman collection for the AI Document Intelligence Platform backend, including Authentication, User Management, and System Health.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "antigravity"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifies that the API server is online and successfully connected to the Supabase PostgreSQL database."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a new user account. Validates email uniqueness and hashes password with bcrypt."
          },
          "response": []
        },
        {
          "name": "2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('access_token', res.data.token.access_token);",
                  "    pm.collectionVariables.set('refresh_token', res.data.token.refresh_token);",
                  "    console.log('Saved access_token and refresh_token to collection variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in the user. Sets HTTP-only cookies in browsers AND returns access/refresh tokens in the JSON response body for mobile apps."
          },
          "response": []
        },
        {
          "name": "3. Get Profile (/me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Retrieves the currently authenticated user's profile info to maintain UI state across page refreshes."
          },
          "response": []
        },
        {
          "name": "4. Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('access_token', res.data.access_token);",
                  "    console.log('Updated access_token in collection variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh-token"
              ]
            },
            "description": "Generates a new access token using a valid refresh token (via cookie, Bearer header, or body payload)."
          },
          "response": []
        },
        {
          "name": "5. Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"SecurePassword123!\",\n  \"new_password\": \"NewSecurePassword456!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "Allows an authenticated user to change their password. Keeps the current device session active while invalidating all other devices' refresh tokens."
          },
          "response": []
        },
        {
          "name": "6. Forgot Password (Request Code)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Requests a 6-digit password reset code. The code is logged to console/log output and stored hashed in DB."
          },
          "response": []
        },
        {
          "name": "7. Verify Password Reset Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.reset_token) {",
                  "    pm.collectionVariables.set('reset_token', res.data.reset_token);",
                  "    console.log('Saved reset_token to collection variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-password-reset-code",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-password-reset-code"
              ]
            },
            "description": "Verifies the 6-digit code sent to the user and exchanges it for a secure, time-limited reset_token."
          },
          "response": []
        },
        {
          "name": "8. Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reset_token\": \"{{reset_token}}\",\n  \"new_password\": \"BrandNewPassword789!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Sets the new password using the reset_token and deletes ALL refresh tokens in the database, logging out all lost or active devices."
          },
          "response": []
        },
        {
          "name": "9. Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('access_token', '');",
                  "pm.collectionVariables.set('refresh_token', '');",
                  "console.log('Cleared tokens from collection variables');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Clears browser cookies and deletes ONLY the current device's refresh token from the database, leaving other devices logged in."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "1. Upload Document (HTTP 202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.document_id) {",
                  "    pm.collectionVariables.set('document_id', res.data.document_id);",
                  "    console.log('Saved document_id to collection variables:', res.data.document_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "title",
                  "value": "Quarterly Financials Report",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/documents/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            },
            "description": "Accepts a PDF, Word document (.docx, .doc), Text (.txt, .md, .csv), or Image (.png, .jpg, .jpeg, .webp, .tiff, .bmp) up to 50MB. Uploads to Amazon S3 and immediately returns HTTP 202 Accepted with document_id and pending status."
          },
          "response": []
        },
        {
          "name": "2. Get Document Details & Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents",
                "{{document_id}}"
              ]
            },
            "description": "Retrieves the processing status, metadata, and presigned S3 download URL for a specific document."
          },
          "response": []
        },
        {
          "name": "3. List User Documents",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents?limit=50&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "documents"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Lists all active documents uploaded by the authenticated user with pagination."
          },
          "response": []
        }
      ]
    }
  ]
}